# 使用 KEY=value 格式，不加引号或 export；本文件仅示例，请复制为 .env 并填写实际值。
# 必填：MYSQL_ROOT_PASSWORD、RABBITMQ_PASS、JWT_SECRET、AI_SERVICE_SECRET。
# 数据库密码（生产环境必须修改）
MYSQL_ROOT_PASSWORD=

# AI 服务间签名密钥、用户密钥加密密钥（分别生成，必填，各为 32 字节的 Base64）
# 生成命令：openssl rand -base64 32
AI_SERVICE_SECRET=
# 平台统一支付模型费用。生产启用 AI 前填写；不要提交真实密钥。
AI_PLATFORM_PROVIDER=deepseek
AI_PLATFORM_MODEL=deepseek-flash
AI_PLATFORM_API_KEY=
# 修改模型/提示词/公共知识后递增，防止复用旧健康报告。
AI_PLATFORM_REVISION=1
# 百炼向量密钥仅用于 AI 服务公共知识库，留空则使用关键词检索。
AI_EMBEDDING_API_KEY=
AI_SERVICE_URL=http://127.0.0.1:8081
AI_REDIS_DATABASE=1
AI_MODEL_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT=8
# 用户模型 API Key 在登录后的「AI 设置」填写，无平台公共密钥回退。

# 邮件配置（QQ邮箱为例，需开启 SMTP 并获取授权码）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=

# RabbitMQ（生产环境必须修改密码）
RABBITMQ_USER=admin
RABBITMQ_PASS=

# CORS 跨域配置（生产环境改成你的域名）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-domain.com

# 提醒调度器
REMINDER_SCHEDULER_ENABLED=true
REDIS_PASSWORD=
JWT_SECRET=
WECHAT_APP_SECRET=
WECHAT_APP_ID=

# JWT 有效期（毫秒），强制下线标记共用该有效期
JWT_EXPIRATION_MS=900000
# 固定会话最长寿命；刷新不延长它。生产必须启用 Secure，HTTP 本地开发可设 false。
JWT_REFRESH_EXPIRATION=7d
JWT_COOKIE_SECURE=true
JWT_ISSUER=health-system
JWT_AUDIENCE=health-clients
# 后端运行参数：均为可选，以下为当前默认值
CHAT_MEMORY_MAX_MESSAGES=20
CHAT_CONTEXT_RECORD_LIMIT=5
CHAT_MEMORY_TTL=7d
RAG_MAX_SNIPPETS=6
RAG_MIN_SCORE=0.1
AI_KNOWLEDGE_DOCUMENT=classpath:rag/health-knowledge.md
DEPARTMENTS_RESOURCE=classpath:catalogs/departments.yml
# 0 自动按 CPU 核数计算；显式设置时 max 不得小于 core
ASYNC_CORE_POOL_SIZE=0
ASYNC_MAX_POOL_SIZE=0
ASYNC_QUEUE_CAPACITY=200
ASYNC_KEEP_ALIVE=60s
ASYNC_SHUTDOWN_WAIT=60s
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_DURATION=15m
# 所有用户共享的 API 流量保护（修改后重启后端）
TRAFFIC_PROTECTION_ENABLED=true
# 持续补充 50 请求/秒，最多积累 50 个请求额度
TRAFFIC_REQUESTS_PER_SECOND=50
TRAFFIC_BURST_CAPACITY=50
# 每个后端实例最多同时处理 16 个 API 请求（包含 SSE）
TRAFFIC_MAX_CONCURRENT_REQUESTS=16
# 同一数据库的后端实例共用同一个 Redis 数据库、key 和速率配置
TRAFFIC_REDIS_KEY=rate:limit:global:api
# Docker 前端构建参数（修改后重新构建镜像）
VITE_REQUEST_TIMEOUT_MS=15000
VITE_SMART_HEALTH_TIMEOUT_MS=90000

# 支付：未配置商户时保持关闭；金额单位“分”，每单一个自然月。
AI_PAYMENT_ENABLED=false
PAYMENT_PUBLIC_BASE_URL=https://api.example.com
AI_PLUS_CENTS=990
AI_PRO_CENTS=1990
AI_PROMAX_CENTS=2990
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_API_V3_KEY=
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
