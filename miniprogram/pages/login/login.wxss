.login-page {
  min-height: 100vh;
  padding: 80rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #667eea 0%, #f4f7fa 40%);
}

/* Logo */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.logo-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 微信登录 */
.wx-login-section {
  margin-bottom: 60rpx;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 500;
}

.wx-login-btn:active {
  opacity: 0.85;
}

.wx-icon {
  margin-right: 12rpx;
  font-weight: bold;
}

.login-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 底部 */
.footer {
  margin-top: auto;
  text-align: center;
  font-size: 24rpx;
}
