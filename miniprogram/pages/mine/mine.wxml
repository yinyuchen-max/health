<view class="mine-page">
  <!-- 用户信息卡片 -->
  <view class="user-header">
    <view class="user-avatar-wrap">
      <text class="user-avatar-text">{{userInitial || '用'}}</text>
    </view>
    <view class="user-info-wrap">
      <text class="user-name">{{userInfo.username || '用户'}}</text>
      <text class="user-slogan">健康生活，快乐每一天</text>
    </view>
  </view>

  <!-- 我的数据 -->
  <view class="card">
    <text class="section-title">我的数据</text>
    <view class="data-icons">
      <view class="data-icon-item" bindtap="goHealthRecord">
        <view class="data-icon-bg data-icon-body">
          <text class="data-icon-emoji">📊</text>
        </view>
        <text class="data-icon-name">身体数据</text>
      </view>
      <view class="data-icon-item" bindtap="goSportRecord">
        <view class="data-icon-bg data-icon-sport">
          <text class="data-icon-emoji">🏃</text>
        </view>
        <text class="data-icon-name">运动数据</text>
      </view>
      <view class="data-icon-item" bindtap="goDietRecord">
        <view class="data-icon-bg data-icon-diet">
          <text class="data-icon-emoji"></text>
        </view>
        <text class="data-icon-name">饮食数据</text>
      </view>
      <view class="data-icon-item" bindtap="goSleepRecord">
        <view class="data-icon-bg data-icon-sleep">
          <text class="data-icon-emoji">😴</text>
        </view>
        <text class="data-icon-name">睡眠数据</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="card">
    <view class="menu-item" bindtap="goGoalSetting">
      <text class="menu-emoji">🎯</text>
      <text class="menu-text">我的目标</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goHistoryRecord">
      <text class="menu-emoji">⭐</text>
      <text class="menu-text">历史记录</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goProfile">
      <text class="menu-emoji">👤</text>
      <text class="menu-text">个人资料</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goReminder">
      <text class="menu-emoji">⏰</text>
      <text class="menu-text">提醒配置</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="subscribeMessage">
      <text class="menu-emoji"></text>
      <text class="menu-text">订阅消息授权</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <button class="btn-logout" bindtap="handleLogout">退出登录</button>
</view>
