.page {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: #f5f3ff;
  min-height: 100vh;
}

/* 日期栏 */
.date-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #fff;
}

.date-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.date-picker {
  font-size: 26rpx;
  color: #7c3aed;
}

/* 热量卡片 */
.calorie-card {
  text-align: center;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.06);
}

.calorie-label {
  font-size: 26rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 12rpx;
}

.calorie-body {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.calorie-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #7c3aed;
  line-height: 1;
}

.calorie-unit {
  font-size: 26rpx;
  color: #9ca3af;
}

.macro-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.macro-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.macro-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.macro-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* 餐次 Tab */
.meal-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.meal-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(139, 92, 246, 0.04);
}

.meal-tab-active {
  background: #7c3aed;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.3);
}

/* 食物列表 */
.food-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(139, 92, 246, 0.04);
}

.food-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.food-emoji {
  font-size: 40rpx;
}

.food-info {
  display: flex;
  flex-direction: column;
}

.food-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.food-amount {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.food-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.food-cal {
  font-size: 28rpx;
  font-weight: 600;
  color: #7c3aed;
}

.food-delete {
  font-size: 22rpx;
  color: #ef4444;
}

/* 区域标题 */
.section-header {
  margin: 24rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

/* 快速食物网格 */
.quick-food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-food-item {
  width: calc(25% - 9rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(139, 92, 246, 0.04);
}

.quick-food-emoji {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.quick-food-name {
  font-size: 22rpx;
  color: #4b5563;
  margin-bottom: 4rpx;
}

.quick-food-cal {
  font-size: 20rpx;
  color: #9ca3af;
}

/* 添加食物按钮 */
.btn-add-food {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.4);
  border: none;
}
