<view class="page">
  <!-- 日期选择 -->
  <view class="date-bar card">
    <text class="date-text">{{selectedDate}}</text>
    <picker mode="date" bindchange="onDateChange" value="{{selectedDate}}">
      <text class="date-picker">切换日期</text>
    </picker>
  </view>

  <!-- 总热量 -->
  <view class="calorie-card card">
    <text class="calorie-label">总热量</text>
    <view class="calorie-body">
      <text class="calorie-value">{{totalCalories}}</text>
      <text class="calorie-unit">千卡</text>
    </view>
    <view class="macro-row">
      <view class="macro-item">
        <text class="macro-value">{{carbPercent}}%</text>
        <text class="macro-label">碳水</text>
      </view>
      <view class="macro-item">
        <text class="macro-value">{{proteinPercent}}%</text>
        <text class="macro-label">蛋白质</text>
      </view>
      <view class="macro-item">
        <text class="macro-value">{{fatPercent}}%</text>
        <text class="macro-label">脂肪</text>
      </view>
    </view>
  </view>

  <!-- 餐次 Tab -->
  <view class="meal-tabs">
    <view class="meal-tab {{currentMeal === item ? 'meal-tab-active' : ''}}"
          wx:for="{{meals}}" wx:key="*this"
          bindtap="switchMeal" data-meal="{{item}}">
      {{item}}
    </view>
  </view>

  <!-- 食物记录列表 -->
  <view class="food-list">
    <view class="food-item card" wx:for="{{currentFoods}}" wx:key="id">
      <view class="food-left">
        <text class="food-emoji">{{item.emoji || ''}}</text>
        <view class="food-info">
          <text class="food-name">{{item.name}}</text>
          <text class="food-amount">{{item.amount}}</text>
        </view>
      </view>
      <view class="food-right">
        <text class="food-cal">{{item.calories}} 千卡</text>
        <text class="food-delete" bindtap="deleteFood" data-id="{{item.id}}">删除</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{currentFoods.length === 0}}">
      <text class="empty-icon"></text>
      <text class="empty-text">暂无{{currentMeal}}记录</text>
      <text class="empty-tip">点击下方快速添加食物</text>
    </view>
  </view>

  <!-- 快速添加食物 -->
  <view class="section-header">
    <text class="section-title">快速添加</text>
  </view>

  <view class="quick-food-grid">
    <view class="quick-food-item" wx:for="{{quickFoods}}" wx:key="name" bindtap="quickAddFood" data-food="{{item}}">
      <text class="quick-food-emoji">{{item.emoji}}</text>
      <text class="quick-food-name">{{item.name}}</text>
      <text class="quick-food-cal">{{item.calories}}kcal</text>
    </view>
  </view>

  <!-- 手动添加按钮 -->
  <button class="btn-add-food" bindtap="openFoodForm">+ 添加食物</button>

  <!-- 添加食物弹窗 -->
  <view class="modal-mask" wx:if="{{showFoodForm}}" bindtap="closeFoodForm">
    <view class="modal-content" catchtap="">
      <text class="modal-title">添加食物</text>

      <view class="form-item">
        <text class="form-label">食物名称</text>
        <input class="form-input" placeholder="输入食物名称" value="{{foodForm.name}}" bindinput="onFoodInput" data-field="name" />
      </view>

      <view class="form-item">
        <text class="form-label">分量</text>
        <input class="form-input" placeholder="如 1碗(150g)" value="{{foodForm.amount}}" bindinput="onFoodInput" data-field="amount" />
      </view>

      <view class="form-item">
        <text class="form-label">热量（千卡）</text>
        <input class="form-input" type="number" placeholder="输入热量" value="{{foodForm.calories}}" bindinput="onFoodInput" data-field="calories" />
      </view>

      <button class="btn-primary" bindtap="submitFood" loading="{{savingFood}}">添加</button>
    </view>
  </view>
</view>
