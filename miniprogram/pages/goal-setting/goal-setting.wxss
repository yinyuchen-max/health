.page {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: #f5f3ff;
  min-height: 100vh;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}

.goal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  margin-top: 24rpx;
}

.goal-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.goal-emoji {
  font-size: 32rpx;
}

.goal-name {
  font-size: 28rpx;
  color: #4b5563;
}

.goal-right {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.goal-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #7c3aed;
}

.goal-unit {
  font-size: 24rpx;
  color: #9ca3af;
}
