.page {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: #f5f3ff;
  min-height: 100vh;
}

/* 微信运动卡片 */
.werun-card {
  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.werun-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.werun-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.werun-sync {
  font-size: 24rpx;
  opacity: 0.8;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,0.4);
  border-radius: 20rpx;
}

.werun-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.werun-steps-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.werun-steps {
  font-size: 72rpx;
  font-weight: bold;
  line-height: 1;
}

.werun-unit {
  font-size: 28rpx;
  opacity: 0.8;
}

.werun-icon {
  font-size: 80rpx;
}

.werun-stats {
  display: flex;
  gap: 24rpx;
}

.werun-stat {
  flex: 1;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 16rpx;
  text-align: center;
}

.werun-stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.werun-stat-label {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 区域标题 */
.section-header {
  margin: 24rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

/* 快速添加运动 */
.quick-sport-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-sport-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.06);
}

.quick-sport-emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.quick-sport-name {
  font-size: 22rpx;
  color: #4b5563;
}

/* 运动记录卡片 */
.record-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.06);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-type-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.record-type-emoji {
  font-size: 32rpx;
}

.record-type-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.record-date {
  font-size: 24rpx;
  color: #9ca3af;
}

.record-stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.record-stat {
  display: flex;
  flex-direction: column;
}

.record-stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.record-stat-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f3f0ff;
}

.record-action-edit {
  font-size: 24rpx;
  color: #7c3aed;
}

.record-action-delete {
  font-size: 24rpx;
  color: #ef4444;
}

/* 手动添加按钮 */
.btn-add-manual {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.4);
  border: none;
}

/* 弹窗内运动类型网格 */
.sport-type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sport-type-item {
  width: calc(25% - 9rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  background: #faf8ff;
  border: 2rpx solid #ede9fe;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.sport-type-active {
  background: #f5f3ff;
  border-color: #7c3aed;
}

.sport-type-emoji {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.sport-type-name {
  font-size: 22rpx;
  color: #4b5563;
}

/* 强度选择 */
.intensity-row {
  display: flex;
  gap: 12rpx;
}

.intensity-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #faf8ff;
  border: 2rpx solid #ede9fe;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.intensity-active {
  background: #f5f3ff;
  border-color: #7c3aed;
  color: #7c3aed;
  font-weight: 500;
}
