<view class="page">
  <view class="card">
    <text class="title">AI 服务</text>
    <text class="hint">模型和知识检索由平台统一提供，无需配置 API Key。</text>
    <text class="hint" wx:if="{{error}}">{{error}}</text>
    <view wx:if="{{status}}">
      <text class="label">{{status.admin ? '管理员 · 免费使用' : status.allowed ? 'AI 服务已开通' : 'AI 服务未开通或已到期'}}</text>
      <text class="hint" wx:if="{{!status.configured}}">平台 AI 服务暂未配置，请联系管理员。</text>
      <view wx:if="{{!status.admin}}">
        <text class="label" wx:for="{{plans}}" wx:key="code">{{item.name}}：¥{{item.price}}/月</text>
        <text class="hint">三档当前功能相同。{{message}}</text>
        <text class="hint">请在网页端完成扫码支付，到账后本账号在网页和小程序均可使用。小程序内暂不支持直接付款。</text>
        <button bindtap="openBilling">复制网页支付入口</button>
      </view>
      <button wx:if="{{status.allowed && status.configured}}" bindtap="chat" type="primary">进入 AI 聊天</button>
    </view>
    <button bindtap="load" loading="{{loading}}" disabled="{{loading}}">刷新服务状态</button>
  </view>
  <view class="card memory-card">
    <text class="title">长期记忆</text>
    <text class="hint">AI 会记住你明确说过的习惯、目标和健康情况。前后不一致时需要你确认，确认前不会用于回答。</text>
    <text class="hint" wx:if="{{memoryError}}">{{memoryError}}</text>
    <view wx:for="{{memories}}" wx:key="id" class="memory-item">
      <text class="label">{{item.status === 'CONFLICT' ? '待确认' : '已记住'}}</text>
      <text class="hint">{{item.content}}</text>
      <text class="hint" wx:if="{{item.pendingContent}}">另一种说法：{{item.pendingContent}}</text>
      <button size="mini" data-id="{{item.id}}" data-content="{{item.pendingContent || item.content}}" bindtap="editMemory">修改并确认</button>
      <button size="mini" data-id="{{item.id}}" bindtap="deleteMemory">删除</button>
    </view>
    <text class="hint" wx:if="{{memoriesLoaded && !memories.length}}">暂无长期记忆。聊过之后可以回来查看。</text>
    <button bindtap="loadMemories" loading="{{memoryLoading}}">刷新记忆</button>
  </view>
</view>
