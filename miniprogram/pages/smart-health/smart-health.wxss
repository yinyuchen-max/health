.page {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

/* 总体状态 */
.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.status-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-good { background: #f6ffed; color: #52c41a; }
.status-fair { background: #fff7e6; color: #fa8c16; }
.status-poor { background: #fff2f0; color: #f5222d; }

.status-time {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* BMI */
.bmi-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #667eea;
  text-align: center;
  margin-top: 12rpx;
}

/* 风险评估 */
.risk-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.risk-item:last-child {
  border-bottom: none;
}

.risk-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.risk-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.risk-score {
  font-size: 24rpx;
  color: #999;
}

.risk-level {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.level-low { background: #f6ffed; color: #52c41a; }
.level-medium { background: #fff7e6; color: #fa8c16; }
.level-high { background: #fff2f0; color: #f5222d; }

.risk-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 快速建议 */
.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.tip-dot {
  color: #667eea;
  margin-right: 12rpx;
  font-size: 28rpx;
}

/* 建议内容 */
.advice-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-sub {
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 刷新按钮 */
.btn-refresh {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}
