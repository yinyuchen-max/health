<view class="page">
  <!-- 基本信息 -->
  <view class="card">
    <text class="section-title">基本信息</text>

    <view class="form-group">
      <text class="form-label">用户名</text>
      <input class="form-input" disabled value="{{userInfo.username}}" />
    </view>

    <view class="form-group">
      <text class="form-label">邮箱</text>
      <input class="form-input" placeholder="请输入邮箱" value="{{userInfo.email}}" bindinput="onInput" data-field="email" />
    </view>

    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{userInfo.phone}}" bindinput="onInput" data-field="phone" />
    </view>

    <view class="form-group">
      <text class="form-label">性别</text>
      <picker bindchange="onGenderChange" value="{{genderIndex}}" range="{{genderOptions}}">
        <view class="picker-value">{{genderOptions[genderIndex]}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">年龄</text>
      <input class="form-input" type="number" placeholder="请输入年龄" value="{{userInfo.age}}" bindinput="onInput" data-field="age" />
    </view>

    <view class="form-group">
      <text class="form-label">身高（cm）</text>
      <input class="form-input" type="digit" placeholder="请输入身高" value="{{userInfo.height}}" bindinput="onInput" data-field="height" />
    </view>

    <view class="form-group">
      <text class="form-label">体重（kg）</text>
      <input class="form-input" type="digit" placeholder="请输入体重" value="{{userInfo.weight}}" bindinput="onInput" data-field="weight" />
    </view>

    <button class="btn-save" bindtap="saveProfile" loading="{{saving}}">保存修改</button>
  </view>

  <!-- 修改密码 -->
  <view class="card">
    <text class="section-title">修改密码</text>

    <view class="form-group">
      <text class="form-label">当前密码</text>
      <input class="form-input" password placeholder="请输入当前密码" value="{{passwordForm.oldPassword}}" bindinput="onPasswordInput" data-field="oldPassword" />
    </view>

    <view class="form-group">
      <text class="form-label">新密码</text>
      <input class="form-input" password placeholder="请输入新密码" value="{{passwordForm.newPassword}}" bindinput="onPasswordInput" data-field="newPassword" />
    </view>

    <view class="form-group">
      <text class="form-label">确认新密码</text>
      <input class="form-input" password placeholder="请再次输入新密码" value="{{passwordForm.confirmPassword}}" bindinput="onPasswordInput" data-field="confirmPassword" />
    </view>

    <button class="btn-password" bindtap="changePassword" loading="{{changing}}">修改密码</button>
  </view>
</view>
