.page {
  padding: 0 24rpx;
  padding-bottom: 140rpx;
  background: #f5f3ff;
  min-height: 100vh;
}

/* 顶部问候卡片 */
.header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  margin-bottom: 8rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
}

.header-subtitle {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
  display: block;
}

.header-avatar {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 80rpx;
}

/* 今日状态卡片 */
.status-card {
  background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-label {
  font-size: 26rpx;
  color: #7c3aed;
  font-weight: 500;
}

.status-edit {
  font-size: 24rpx;
  color: #7c3aed;
}

.status-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-emoji {
  font-size: 48rpx;
}

.status-text-wrap {
  display: flex;
  flex-direction: column;
}

.status-mood {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.status-tip {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.action-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.action-icon-health {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
}

.action-icon-diet {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
}

.action-icon-sport {
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
}

.action-icon-sleep {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.action-emoji {
  font-size: 40rpx;
}

.action-name {
  font-size: 24rpx;
  color: #4b5563;
}

/* 今日数据 */
.data-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.section-more {
  font-size: 24rpx;
  color: #7c3aed;
}

.data-grid {
  display: flex;
  gap: 16rpx;
}

.data-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.06);
}

.data-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f5f3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.data-emoji {
  font-size: 28rpx;
}

.data-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.data-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
  line-height: 1.2;
}

.data-unit {
  font-size: 20rpx;
  color: #9ca3af;
  margin-bottom: 10rpx;
}

.data-card .progress-bar {
  width: 100%;
  height: 8rpx;
}

/* 健康小贴士 */
.tip-card {
  background: #faf8ff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 6rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #6b7280;
  display: block;
}

.tip-emoji {
  font-size: 48rpx;
  margin-left: auto;
}

/* 更多功能 */
.more-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.more-item {
  width: calc(33.33% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.more-emoji {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.more-name {
  font-size: 24rpx;
  color: #4b5563;
}
