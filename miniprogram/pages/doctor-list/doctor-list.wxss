.page {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.dept-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.dept-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.dept-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.dept-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.doctor-list {
  margin-bottom: 20rpx;
}

.doctor-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.doctor-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.doctor-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.doctor-info {
  display: flex;
  flex-direction: column;
}

.doctor-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.doctor-title {
  font-size: 24rpx;
  color: #667eea;
  margin-top: 4rpx;
}

.doctor-detail {
  margin-bottom: 16rpx;
}

.detail-row {
  display: flex;
  padding: 8rpx 0;
}

.detail-label {
  width: 100rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.doctor-intro {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  padding: 12rpx 0;
  border-top: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.btn-appointment {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: none;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
