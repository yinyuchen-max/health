<view class="chat-page">
  <navigator url="/pages/ai-settings/ai-settings" style="padding: 16rpx 24rpx; color: #6366f1">AI 服务 · 开通、续费与记忆</navigator>
  <view wx:if="{{accessMessage}}" class="notice">{{accessMessage}}</view>
  <navigator wx:if="{{conflictCount}}" url="/pages/ai-settings/ai-settings" class="notice">有 {{conflictCount}} 条记忆需要你确认，确认前不会用于回答</navigator>
  <view wx:if="{{emergency}}" class="notice emergency">如果这是正在发生的紧急情况，请立即拨打 120 或就近急诊。</view>
  <!-- 消息列表 -->
  <scroll-view
    class="chat-scroll"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
  >
    <!-- 欢迎页 -->
    <view wx:if="{{messages.length === 0}}" class="welcome">
      <view class="welcome-orb">🤖</view>
      <text class="welcome-title">你好，我是你的 AI 健康顾问</text>
      <text class="welcome-sub">可以问我任何健康问题，也可以点下面的快捷问题开始</text>
      <view class="quick-grid">
        <view wx:for="{{quickQuestions}}" wx:key="text" class="quick-card" bindtap="sendQuick" data-text="{{item.text}}">
          <text class="quick-icon">{{item.icon}}</text>
          <text class="quick-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 消息 -->
    <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}" class="msg-row {{item.role}}">
      <block wx:if="{{item.role === 'assistant'}}">
        <view class="avatar assistant-avatar">🤖</view>
        <view class="bubble assistant-bubble">
          <text wx:if="{{item.streaming && !item.content}}" class="typing-dots">
            <text class="dot"></text><text class="dot"></text><text class="dot"></text>
          </text>
          <text wx:else class="bubble-text">{{item.content}}</text>
          <text wx:if="{{item.contextNote}}" class="context-note">{{item.contextNote}}</text>
          <view wx:if="{{!item.streaming && !loading}}" class="msg-actions">
            <text bindtap="copyMessage" data-text="{{item.content}}">复制</text>
            <text wx:if="{{index === messages.length - 1}}" bindtap="regenerate">重新生成</text>
            <text bindtap="rateMessage" data-rating="USEFUL" data-text="{{item.content}}">有帮助</text>
            <text bindtap="rateMessage" data-rating="INACCURATE" data-text="{{item.content}}">需要纠正</text>
          </view>
          <view wx:if="{{item.appointment && !loading}}" class="appointment-card">
            <text>需要预约医生？说出症状后，AI 会帮你确认科室和时间。</text>
            <button size="mini" bindtap="sendAppointment">继续预约</button>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="bubble user-bubble">{{item.content}}</view>
        <view class="avatar user-avatar">我</view>
      </block>
    </view>

    <view style="height: 20rpx;"></view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="chat-footer">
    <view class="input-wrap">
      <input
        class="chat-input"
        value="{{inputText}}"
        bindinput="onInput"
        bindconfirm="sendMessage"
        placeholder="输入你的健康问题…"
        disabled="{{loading || !aiAllowed}}"
        confirm-type="send"
      />
      <view class="btn-clear" bindtap="clearHistory">清空</view>
      <view wx:if="{{loading}}" class="btn-stop" bindtap="stopStreaming">停止</view>
      <view wx:else class="btn-send {{inputText ? 'active' : ''}}" bindtap="sendMessage">发送</view>
    </view>
    <text class="input-hint">内容由 AI 生成，仅供参考，不能代替医生诊断。胸痛、呼吸困难、严重出血或昏迷请立即拨打 120。</text>
  </view>
</view>
