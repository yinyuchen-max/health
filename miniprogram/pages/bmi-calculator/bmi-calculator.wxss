.page {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: #f5f3ff;
  min-height: 100vh;
}

/* 输入行 */
.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-row .form-input {
  flex: 1;
}

.input-unit {
  font-size: 28rpx;
  color: #9ca3af;
  min-width: 40rpx;
}

/* 结果卡片 */
.result-card {
  text-align: center;
  padding: 40rpx 28rpx;
}

.result-label {
  font-size: 26rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 12rpx;
}

.result-value {
  font-size: 80rpx;
  font-weight: bold;
  display: block;
  line-height: 1;
  margin-bottom: 8rpx;
}

.result-level {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 32rpx;
}

.result-normal { color: #10b981; }
.result-underweight { color: #3b82f6; }
.result-overweight { color: #f59e0b; }
.result-obese { color: #ef4444; }

/* BMI 标尺 */
.bmi-scale {
  margin-bottom: 32rpx;
}

.scale-bar {
  height: 12rpx;
  background: linear-gradient(90deg, #3b82f6 0%, #10b981 30%, #10b981 60%, #f59e0b 80%, #ef4444 100%);
  border-radius: 6rpx;
  position: relative;
  margin-bottom: 12rpx;
}

.scale-fill {
  position: absolute;
  top: -6rpx;
  width: 24rpx;
  height: 24rpx;
  background: #fff;
  border: 4rpx solid #7c3aed;
  border-radius: 50%;
  transform: translateX(-50%);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.scale-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.scale-label {
  font-size: 22rpx;
  color: #6b7280;
}

.scale-values {
  display: flex;
  justify-content: space-between;
  padding: 0 10%;
}

.scale-value {
  font-size: 20rpx;
  color: #9ca3af;
}

.result-desc {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.5;
}
