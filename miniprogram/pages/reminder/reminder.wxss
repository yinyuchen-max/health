.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.toolbar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.btn-add {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.5;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}

.reminder-card {
  margin-bottom: 20rpx;
}

.reminder-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reminder-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reminder-type {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.reminder-time {
  font-size: 26rpx;
  color: #667eea;
}

.reminder-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reminder-notes {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

.reminder-actions {
  display: flex;
  gap: 20rpx;
}

.action-edit {
  font-size: 26rpx;
  color: #667eea;
}

.action-delete {
  font-size: 26rpx;
  color: #ff4d4f;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 30rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.form-picker {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 150rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-footer button {
  flex: 1;
}
