.page {
  padding: 20rpx;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.filter-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.filter-item .arrow {
  font-size: 20rpx;
  margin-left: 4rpx;
}

.list-container {
  margin-bottom: 20rpx;
}

.record-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-type {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.type-health { background: #e6f7ff; color: #1890ff; }
.type-sport { background: #f6ffed; color: #52c41a; }
.type-reminder { background: #fff7e6; color: #fa8c16; }

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.record-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
