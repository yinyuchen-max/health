.page {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: #f5f3ff;
  min-height: 100vh;
}

/* 日期栏 */
.date-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #fff;
}

.date-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.date-picker {
  font-size: 26rpx;
  color: #7c3aed;
}

/* 睡眠时长卡片 */
.sleep-card {
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
}

.sleep-label {
  font-size: 26rpx;
  color: #7c3aed;
  display: block;
  margin-bottom: 16rpx;
}

.sleep-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sleep-time-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.sleep-hours {
  font-size: 80rpx;
  font-weight: bold;
  color: #1f2937;
  line-height: 1;
}

.sleep-unit1 {
  font-size: 26rpx;
  color: #6b7280;
}

.sleep-minutes {
  font-size: 48rpx;
  font-weight: bold;
  color: #1f2937;
}

.sleep-unit2 {
  font-size: 26rpx;
  color: #6b7280;
}

.sleep-moon {
  font-size: 80rpx;
}

.sleep-quality-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sleep-quality-label {
  font-size: 24rpx;
  color: #6b7280;
}

.sleep-quality-tags {
  display: flex;
  gap: 10rpx;
}

.sleep-quality-tag {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #6b7280;
  background: rgba(255,255,255,0.6);
}

.sleep-quality-active {
  background: #7c3aed;
  color: #fff;
}

/* 时间卡片 */
.time-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.time-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.06);
}

.time-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.time-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
}

/* 区域标题 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
  margin-bottom: 20rpx;
}

/* 睡眠阶段 */
.sleep-phases {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.phase-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.phase-bar {
  height: 16rpx;
  border-radius: 8rpx;
}

.phase-deep { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
.phase-light { background: linear-gradient(90deg, #a78bfa, #c4b5fd); }
.phase-rem { background: linear-gradient(90deg, #c4b5fd, #ddd6fe); }

.phase-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 睡眠建议 */
.sleep-tips {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sleep-tip {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  padding-left: 16rpx;
  border-left: 4rpx solid #a78bfa;
}
