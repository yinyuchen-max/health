/* 全局样式 - 紫色健康主题 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f3ff;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 卡片样式 - 圆角白色 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(139, 92, 246, 0.06);
}

/* 渐变紫色卡片 */
.card-purple {
  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

/* 主按钮 - 紫色 */
.btn-primary {
  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
}

/* 次要按钮 */
.btn-secondary {
  background: #f5f3ff;
  color: #7c3aed;
  border: 2rpx solid #e9d5ff;
  border-radius: 40rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  text-align: center;
}

/* 输入框 */
.input-item {
  background: #faf8ff;
  border: 2rpx solid #ede9fe;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.input-item:focus {
  border-color: #a78bfa;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f0ff;
}

.list-item:last-child {
  border-bottom: none;
}

/* 文字颜色 */
.text-primary { color: #7c3aed; }
.text-success { color: #10b981; }
.text-warning { color: #f59e0b; }
.text-danger  { color: #ef4444; }
.text-muted   { color: #9ca3af; }
.text-purple  { color: #7c3aed; }

/* 间距 */
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-30 { margin-bottom: 30rpx; }

/* Flex 布局 */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: #ede9fe;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #a78bfa, #7c3aed);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
  color: #1f2937;
}

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 10rpx;
}

.form-input {
  background: #faf8ff;
  border: 2rpx solid #ede9fe;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.form-picker {
  background: #faf8ff;
  border: 2rpx solid #ede9fe;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  background: #faf8ff;
  border: 2rpx solid #ede9fe;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 140rpx;
  box-sizing: border-box;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-purple {
  background: #f5f3ff;
  color: #7c3aed;
}

.tag-green {
  background: #ecfdf5;
  color: #10b981;
}

.tag-orange {
  background: #fff7ed;
  color: #f59e0b;
}

.tag-red {
  background: #fef2f2;
  color: #ef4444;
}
